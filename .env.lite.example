APP_IMAGE=ghcr.io/ywainzh/new-api:2026.06.29-1
PORT=3000
HOST_BIND=127.0.0.1
HOST_PORT=38080
TZ=Asia/Shanghai

# Required: replace before deployment.
SESSION_SECRET=change_me_to_a_long_random_string

# Personal single-container deployment.
PERSONAL_MODE_ENABLED=true
SQLITE_PATH=/data/new-api.db
MEMORY_CACHE_ENABLED=true
ERROR_LOG_ENABLED=false
BATCH_UPDATE_ENABLED=false
UPDATE_TASK=false
NODE_NAME=new-api-personal-1

# Keep these unset for the lite profile.
# SQL_DSN=
# LOG_SQL_DSN=
# REDIS_CONN_STRING=
